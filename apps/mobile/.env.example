# Mobile app environment variables.
# Copy this file to .env.local and fill in real values.
# Variables MUST be prefixed with EXPO_PUBLIC_ to be available at runtime.

# Supabase — same project as apps/web
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ClaroBill API base URL.
# - Production: https://www.clarobill.com
# - Local Next.js dev server (iOS Simulator only): http://localhost:3000
# - Physical device + local dev: http://<your-mac-LAN-ip>:3000 (e.g. http://192.168.1.42:3000)
EXPO_PUBLIC_API_URL=https://www.clarobill.com
