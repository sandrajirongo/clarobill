# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # NOT the anon key — full DB access

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Google Cloud — Vision AI (OCR)
# Local dev: point to a key file path
GOOGLE_APPLICATION_CREDENTIALS=/path/to/clarobill-vision-sa.json
# Deployed (Railway/Fly.io): paste full JSON content instead
GOOGLE_CREDENTIALS_JSON=

# Google Cloud — BigQuery reader (hospital price lookups)
# Local dev: leave empty to reuse GOOGLE_APPLICATION_CREDENTIALS fallback
# Deployed: paste full JSON content of clarobill-bq-reader-sa key
BQ_READER_CREDENTIALS_JSON=

# GCP project + BigQuery dataset (hospital price transparency)
GCP_PROJECT_ID=clarobill-prod
BIGQUERY_DATASET=hospital_prices
GCS_MRF_STAGING_BUCKET=mrf-staging

# SendGrid
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@clarobill.com

# Shared API key — Vercel passes this as X-Engine-Api-Key on every request.
# Leave empty for local dev (check is skipped). Required in production.
ENGINE_API_KEY=

# Sentry (optional — errors silently dropped if not set)
SENTRY_DSN=

# Service configuration
ENVIRONMENT=development  # development | production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
