# Supabase — get from Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Beta mode — when 'true' (or unset), every paid tier is unlocked for free,
# Stripe is bypassed, and beta callouts/strikethroughs render across the UI.
# Set to 'false' in production at launch to enable live billing.
NEXT_PUBLIC_BETA_MODE=true

# Stripe — get from Stripe Dashboard > Developers > API Keys
# Use pk_test_ / sk_test_ for dev, pk_live_ / sk_live_ for prod
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Get from Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# NOTE: pricing is tier-based, NOT a single env-var amount. The fee is
# computed from total_potential_savings via getPriceTier() in
# apps/web/src/lib/pricing.ts. To change tier values, edit that file
# (single source of truth) — no env var changes required.

# Engine service URL (FastAPI)
ENGINE_URL=http://localhost:8000

# Sentry — get from Sentry project settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# PostHog analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# GA4 — Google Analytics measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Webmaster verification codes (leave empty to omit the meta tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
